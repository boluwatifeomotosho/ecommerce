# Copy this file to `.env` (gitignored) and fill in the values.
# Spring Boot auto-imports `.env` at startup via `spring.config.import`
# in application.yaml — no profile flag or IDE plugin needed.

# Gmail SMTP app password (https://myaccount.google.com/apppasswords).
# Generate one with 2FA enabled, then paste the 16-char code below.
MAIL_PASSWORD=

# Optional overrides — leave blank to use the defaults in application.yaml.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=legendaryboluwatife@gmail.com
# MAIL_FROM=legendaryboluwatife@gmail.com
# MAIL_FROM_NAME=Pinepetosan Marketplace
