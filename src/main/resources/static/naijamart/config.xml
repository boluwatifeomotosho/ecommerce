<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        id="com.justjava.naijamart"
        version="1.0.0">

    <name>NaijaMart</name>
    <description>NaijaMart — Nigeria's online marketplace.</description>
    <author email="support@justjava.com">Just Java</author>

    <content src="index.html" />

    <!-- Android SDK targets -->
    <preference name="android-minSdkVersion"     value="24" />
    <preference name="android-targetSdkVersion"  value="36" />
    <preference name="android-compileSdkVersion" value="36" />

    <!-- UX -->
    <preference name="DisallowOverscroll"  value="true" />
    <preference name="Orientation"         value="portrait" />
    <preference name="Fullscreen"          value="false" />
    <preference name="AndroidLaunchMode"   value="singleTask" />
    <preference name="BackgroundColor"     value="0xFFFFFFFF" />

    <!-- Allow all network access (filtered by allow-navigation below) -->
    <access origin="*" />

    <!-- App server -->
    <allow-navigation href="https://ecommerce-production-9470.up.railway.app/*" />

    <!-- Keycloak auth server -->
    <allow-navigation href="https://ngcloak-production.up.railway.app/*" />

    <!-- Paystack payment pages -->
    <allow-navigation href="https://checkout.paystack.com/*" />
    <allow-navigation href="https://*.paystack.co/*" />
    <allow-navigation href="https://paystack.com/*" />

    <!-- CDN resources loaded by pages -->
    <allow-navigation href="https://fonts.googleapis.com/*" />
    <allow-navigation href="https://fonts.gstatic.com/*" />
    <allow-navigation href="https://cdn.tailwindcss.com/*" />
    <allow-navigation href="https://cdnjs.cloudflare.com/*" />

    <!-- System intents -->
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />

    <!-- App icon -->
    <platform name="android">
        <icon src="res/icon/android/icon.png" />
    </platform>

</widget>
